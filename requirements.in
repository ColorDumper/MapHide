# The packages MapHide needs to run. Edit this file, not requirements.txt.
#
# requirements.txt and requirements-dev.txt are generated from this file and
# requirements-dev.in, pinning every package MapHide installs (including the
# ones these pull in) with checksums. After editing either .in file, run:
#   pip-compile --generate-hashes --allow-unsafe --strip-extras requirements.in
#   pip-compile --generate-hashes --allow-unsafe --strip-extras requirements-dev.in
